  {
   "name": "Long ATM straddle 09:20\u219215:15 (baseline)",
   "family": "volatility-long",
   "hypothesis": "Intraday realized moves in NIFTY exceed what the ATM straddle prices in, so a held long straddle earns money after costs.",
   "mechanism": "Buyer of volatility; profits only if the day's move beats premium decay plus the variance risk premium sellers demand. Literature (variance risk premium) predicts this LOSES on average; it is the reference point for the volatility family.",
   "novelty": "Baseline. User's straddle-page runs covered Jul\u2013Oct 2026 with targets; this is the plain held version on the in-sample half only.",
   "failure_modes": "Rejected if net \u2264 0 or PF < 1.15 in-sample.",
   "criteria": {
    "min_trades": 100
   },
   "spec": {
    "name": "Long ATM straddle 09:20",
    "underlying": "NIFTY",
    "timeframe": "1m",
    "schedule": {
     "entry": {
      "type": "time",
      "time": "09:20"
     }
    },
    "position": {
     "legs": [
